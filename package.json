{
  "name": "fuyomi",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.32.1",
  "description": "A browser-based music note reading practice app.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint --ext .ts,.tsx .",
    "typecheck:safety": "tsc -p tsconfig.type-safety.json --noEmit",
    "verify:security": "node scripts/verify-security.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e:install": "playwright install chromium",
    "test:e2e": "playwright test",
    "test:e2e:console": "playwright test e2e/console.spec.ts --project=chromium",
    "verify": "pnpm format:check && pnpm lint && pnpm typecheck:safety && pnpm verify:security && pnpm test",
    "verify:ui": "pnpm verify && pnpm test:e2e:console",
    "verify:full": "pnpm verify:ui && pnpm test:e2e && pnpm build"
  },
  "dependencies": {
    "@radix-ui/themes": "^3.3.0",
    "fp-ts": "^2.16.11",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "vexflow": "5.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@playwright/test": "^1.59.1",
    "@types/node": "^25.5.0",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "@typescript-eslint/eslint-plugin": "^8.58.0",
    "@typescript-eslint/parser": "^8.58.0",
    "@vitejs/plugin-react": "^5.2.0",
    "eslint": "^9.39.4",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-functional": "^9.0.4",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-react-hooks": "^7.0.1",
    "playwright": "^1.59.1",
    "prettier": "^3.8.1",
    "typescript": "~5.8.3",
    "vite": "^7.3.2",
    "vitest": "^4.1.1"
  }
}
